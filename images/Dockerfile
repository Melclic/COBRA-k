FROM --platform=linux/amd64 continuumio/miniconda3

RUN conda update -n base -c defaults conda

COPY environment.yml .
RUN conda env create -f environment.yml

RUN git clone -b bug_fix_issue_5 https://github.com/Melclic/COBRA-k

WORKDIR /COBRA-k

RUN conda run -n metaxime pip install -e .

RUN apt-get install wget

WORKDIR database_data/

#data that can be downloaded from the web directly
RUN wget http://bigg.ucsd.edu/static/namespace/bigg_models_metabolites.txt
RUN wget https://ftp.ncbi.nih.gov/pub/taxonomy/taxdmp.zip
RUN wget https://ftp.expasy.org/databases/enzyme/enzyme.rdf

#data that can be downloaded but is painful, better to copy
COPY database_data/sabio_single_tsvs.zi[p] .
COPY database_data/sabio_full_tsv.zi[p] .

#data that is required to be downloaded yourself
COPY database_data/brenda_2025_1.json.tar.gz .

#data that is generated by the COBRA-k but you can download
#TODO

WORKDIR /COBRA-k
RUN mkdir enriched_models

#generate enriched COBRA-k data
COPY models.tar.gz .
COPY generate_enriched_models.py .
RUN tar -xzf models.tar.gz
RUN conda run -n metaxime python generate_enriched_models.py

#make sure that the environment is default
ENV CONDA_DIR=/opt/conda
ENV PATH=$CONDA_DIR/bin:$PATH
ENV CONDA_DEFAULT_ENV=cobrak
ENV PATH=$CONDA_DIR/envs/$CONDA_DEFAULT_ENV/bin:$PATH
RUN echo "source activate $CONDA_DEFAULT_ENV" >> ~/.bashrc
RUN conda run -n cobrak python -V
#required so that we can launch the correct environment
CMD ["bash"]
